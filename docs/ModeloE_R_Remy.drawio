        <mxCell id="R4S_bVo88ajQV7gVfzij-32" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="(0,n)" vertex="1">
